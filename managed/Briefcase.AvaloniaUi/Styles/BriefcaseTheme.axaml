<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="Background" Value="#6619141F" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="#F6F1F8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#B32E2037" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
  </Style>

  <Style Selector="Button.briefcase-primary">
    <Setter Property="Background" Value="#A45BE0" />
    <Setter Property="BorderBrush" Value="#B96CF0" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.briefcase-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#B96CF0" />
    <Setter Property="BorderBrush" Value="#C890F6" />
  </Style>

  <Style Selector="Button.briefcase-secondary">
    <Setter Property="Background" Value="#5219141F" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
    <Setter Property="Foreground" Value="#F6F1F8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.briefcase-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#A45BE0" />
    <Setter Property="BorderBrush" Value="#B96CF0" />
  </Style>

  <Style Selector="Button.briefcase-danger">
    <Setter Property="Background" Value="#7A321C2A" />
    <Setter Property="BorderBrush" Value="#FF647C" />
    <Setter Property="Foreground" Value="#FFF7F8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.briefcase-danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C9445864" />
  </Style>

  <Style Selector="Button.briefcase-compact">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Button.briefcase-navigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.briefcase-navigation:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#A32E2037" />
    <Setter Property="BorderBrush" Value="#72493455" />
  </Style>

  <Style Selector="Button.briefcase-navigation-active">
    <Setter Property="Background" Value="#B32E2037" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
  </Style>

  <Style Selector="Button.briefcase-navigation-root">
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style Selector="TabControl.briefcase-tabs">
    <Setter Property="Background" Value="#E619141F" />
  </Style>

  <Style Selector="TabItem.briefcase-tab">
    <Setter Property="Background" Value="#E6151019" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="#B4A9B8" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Header}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabItem.briefcase-tab:pointerover">
    <Setter Property="Background" Value="#A32E2037" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
  </Style>

  <Style Selector="TabItem.briefcase-tab:selected">
    <Setter Property="Background" Value="#B32E2037" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
    <Setter Property="Foreground" Value="#F6F1F8" />
  </Style>

  <Style Selector="Border.briefcase-card">
    <Setter Property="Background" Value="#EB241A2B" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.briefcase-card:pointerover">
    <Setter Property="Background" Value="#F02E2037" />
    <Setter Property="BorderBrush" Value="#9A654C75" />
  </Style>

  <Style Selector="Border.briefcase-card-accent">
    <Setter Property="Background" Value="#A45BE0" />
  </Style>

  <Style Selector="Border.briefcase-card.briefcase-flat-card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#4A493455" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.briefcase-card.briefcase-flat-card:pointerover">
    <Setter Property="Background" Value="#462E2037" />
    <Setter Property="BorderBrush" Value="#72493455" />
  </Style>

  <Style Selector="Border.briefcase-setting-row">
    <Setter Property="Background" Value="#52151019" />
    <Setter Property="BorderBrush" Value="#4A493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,3" />
  </Style>

  <Style Selector="Border.briefcase-actionbar">
    <Setter Property="Background" Value="#F52A2031" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="5,5,0,0" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="Border.briefcase-status">
    <Setter Property="Background" Value="#68241A2B" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.briefcase-status TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.briefcase-status-information">
    <Setter Property="Background" Value="#623C2452" />
    <Setter Property="BorderBrush" Value="#A45BE0" />
  </Style>

  <Style Selector="Border.briefcase-status-success">
    <Setter Property="Background" Value="#52304B3E" />
    <Setter Property="BorderBrush" Value="#59D69D" />
  </Style>

  <Style Selector="Border.briefcase-status-warning">
    <Setter Property="Background" Value="#594A3724" />
    <Setter Property="BorderBrush" Value="#F2B765" />
  </Style>

  <Style Selector="Border.briefcase-status-error">
    <Setter Property="Background" Value="#663B202B" />
    <Setter Property="BorderBrush" Value="#FF647C" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#C9151019" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#C9151019" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="#C9151019" />
    <Setter Property="BorderBrush" Value="#72493455" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Foreground" Value="#F6F1F8" />
  </Style>
</Styles>
