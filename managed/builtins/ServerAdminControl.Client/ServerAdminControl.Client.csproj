<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ServerAdminControl.Client</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BriefcaseRequiresGeneratedClientSdk>true</BriefcaseRequiresGeneratedClientSdk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Briefcase.ModApi\Briefcase.ModApi.csproj" Private="false" />
    <ProjectReference Include="..\..\Briefcase.ClientModApi\Briefcase.ClientModApi.csproj" Private="false" />
    <Compile Include="..\ServerAdminControl.Shared\ServerAdminProtocol.cs"
             Link="Protocol\ServerAdminProtocol.cs" />
    <Compile Include="..\ServerAdminControl.Shared\ServerAdminAuthentication.cs"
             Link="Protocol\ServerAdminAuthentication.cs" />
    <Compile Include="..\ServerAdminControl.Shared\ModHandshakeProtocol.cs"
             Link="Protocol\ModHandshakeProtocol.cs" />
  </ItemGroup>
  <Import Project="$(BriefcaseGeneratedClientProps)" Condition="Exists('$(BriefcaseGeneratedClientProps)')" />
</Project>
