<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Briefcase.Core.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Briefcase.ManagedHost\Briefcase.ManagedHost.csproj" />
    <ProjectReference Include="..\..\managed\Briefcase.ModApi\Briefcase.ModApi.csproj" />
    <ProjectReference Include="..\..\managed\Briefcase.SdkEmitter\Briefcase.SdkEmitter.csproj" />
    <Compile Include="..\..\managed\builtins\ServerAdminControl.Shared\ServerAdminProtocol.cs"
             Link="Protocol\ServerAdminProtocol.cs" />
    <Compile Include="..\..\managed\builtins\ServerAdminControl.Shared\ServerAdminAuthentication.cs"
             Link="Protocol\ServerAdminAuthentication.cs" />
    <Compile Include="..\..\managed\builtins\ServerAdminControl.Shared\ModHandshakeProtocol.cs"
             Link="Protocol\ModHandshakeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
