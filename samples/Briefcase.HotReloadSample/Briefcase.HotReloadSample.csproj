<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Briefcase.HotReloadSample</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BriefcaseRequiresGeneratedClientSdk>true</BriefcaseRequiresGeneratedClientSdk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\managed\Briefcase.ModApi\Briefcase.ModApi.csproj" Private="false" />
  </ItemGroup>
  <Import Project="$(BriefcaseGeneratedClientProps)" Condition="Exists('$(BriefcaseGeneratedClientProps)')" />
</Project>
