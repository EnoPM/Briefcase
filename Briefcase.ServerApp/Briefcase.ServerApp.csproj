<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/BriefcaseIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BriefcaseNativeBuildDirectory Condition="'$(BriefcaseNativeBuildDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\BriefcaseNative\build</BriefcaseNativeBuildDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(BriefcaseNativeBuildDirectory)\Briefcase.ServerInjector.exe" Link="Native\Briefcase.ServerInjector.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(BriefcaseNativeBuildDirectory)\Briefcase.ServerInjector.exe')" />
    <Content Include="$(BriefcaseNativeBuildDirectory)\Briefcase.ServerBootstrap.dll" Link="Native\Briefcase.ServerBootstrap.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(BriefcaseNativeBuildDirectory)\Briefcase.ServerBootstrap.dll')" />
    <AvaloniaResource Include="Assets/Game/UI/**/*.png" />
    <AvaloniaResource Include="Assets/BriefcaseIcon.png" />
    <EmbeddedResource Include="Assets/BriefcaseServerBridgeIcon.png" LogicalName="Briefcase.ServerApp.BridgeLogo.png" />
    <EmbeddedResource Include="../marketplace/assets/PlayerCapIcon.png" LogicalName="Briefcase.ServerApp.PlayerCapLogo.png" />
    <EmbeddedResource Include="../marketplace/assets/PregameTimerIcon.png" LogicalName="Briefcase.ServerApp.PregameTimerLogo.png" />
    <EmbeddedResource Include="../marketplace/assets/SuspicionControlIcon.png" LogicalName="Briefcase.ServerApp.SuspicionControlLogo.png" />
    <AvaloniaResource Include="Assets/BriefcaseIcon.ico" />
    <AvaloniaResource Include="Assets/Game/IconCatalog.json" />
    <EmbeddedResource Include="Translations/en.json" LogicalName="Briefcase.ServerApp.Fallback.en.json" />
    <EmbeddedResource Include="Schemas/ServerConfiguration.json" LogicalName="Briefcase.ServerApp.Fallback.ServerConfiguration.json" />
    <None Update="Schemas/ServerConfiguration.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Translations/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
