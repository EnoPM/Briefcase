    {
      "key": "GameMode",
      "label": "Game mode",
      "group": "Game",
      "kind": "choice",
      "default": "Solo",
      "choices": [
        "Solo",
        "Duo",
        "Trio"
      ]
    },
    {
      "key": "MaxPlayers",
