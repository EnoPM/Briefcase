{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enopm.github.io/Briefcase/schemas/mod-manifest.schema.json",
  "title": "Briefcase mod package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entryAssembly"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entryAssembly": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
    "id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,126}[A-Za-z0-9]$" },
    "version": { "type": ["string", "null"] },
    "dependencies": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "updates": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repository", "asset"],
      "properties": {
        "repository": { "type": "string" },
        "asset": { "type": "string", "pattern": "^[^/\\\\]+\\.zip$" },
        "automatic": { "type": "boolean", "default": true }
      }
    }
  }
}
